# Grid Inspection Ops Environment Configuration Template
# Copy this file to .env and configure as needed.

# Hugging Face Model Repository
GRID_MODEL_REPO_ID=cankiziloz/grid-inspection-patchcore-v1
GRID_MODEL_REVISION=main
GRID_MODEL_CACHE_DIR=runtime/models/grid-patchcore-v1

# Storage & Runtime
DATABASE_PATH=runtime/inspections.db
RUNTIME_DIR=runtime

# Retrieval & Explanation Providers
# RETRIEVAL_PROVIDER: 'local' (deterministic Markdown SOP retrieval) or 'pinecone'
RETRIEVAL_PROVIDER=local

# EXPLANATION_PROVIDER: 'template' (safe deterministic explainer) or 'ollama'
EXPLANATION_PROVIDER=template
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# CORS settings for Frontend
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional Pinecone Settings (only needed if RETRIEVAL_PROVIDER=pinecone)
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=
# PINECONE_NAMESPACE=grid-inspection-sop-v1
# PINECONE_EMBEDDING_FIELD=chunk_text
